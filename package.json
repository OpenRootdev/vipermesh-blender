{
  "name": "vipermesh-blender-mcp",
  "version": "1.3.0",
  "description": "Free Blender MCP addon for AI-assisted scene editing, designed for fewer AI tokens, faster work and better-checked results",
  "license": "MIT",
  "private": false,
  "type": "module",
  "author": "ViperMesh contributors",
  "homepage": "https://openrootdev.github.io/vipermesh-blender/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenRootdev/vipermesh-blender.git"
  },
  "bugs": {
    "url": "https://github.com/OpenRootdev/vipermesh-blender/issues"
  },
  "keywords": [
    "blender",
    "mcp",
    "model-context-protocol",
    "3d",
    "ai-agent",
    "blender-addon",
    "blender-ai",
    "3d-modeling",
    "scene-editing",
    "game-development",
    "automation"
  ],
  "bin": {
    "vipermesh-blender": "./dist/public-portable-blender-mcp.js"
  },
  "files": ["addon", "dist", "docs", "skills", "README.md", "LICENSE"],
  "scripts": {
    "mcp": "tsx scripts/public-portable-blender-mcp.ts",
    "build": "tsup scripts/public-portable-blender-mcp.ts --format esm --platform node --out-dir dist --clean",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/conformance.ts",
    "audit": "npm audit --audit-level=moderate",
    "check": "npm run typecheck && npm test && npm run build && node scripts/validate-package.mjs && npm run audit",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.11",
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=20"
  }
}
